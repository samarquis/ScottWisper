<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  
  <!-- 
    WhisperKey.Setup.wxs - Main WiX source file
    Orchestrates the entire MSI package
  -->

  <!-- Include fragment files -->
  <?include Variables.wxi ?>
  <?include Config.wxi ?>
  <?include Logging.wxi ?>

  <Package Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="$(var.ProductName) - Voice Dictation for Windows"
                        Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="no"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- 
      Main Feature - references Components.wxs
    -->
    <Feature Id="ProductFeature"
             Title="$(var.ProductName)"
             Level="1"
             AllowAdvertise="no">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ResourcesComponents" />
      <ComponentGroupRef Id="RegistryComponents" />
      <ComponentGroupRef Id="UserRegistryComponents" />
      <ComponentGroupRef Id="UninstallRegistryComponents" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
      <ComponentGroupRef Id="DesktopShortcuts" />
      <ComponentGroupRef Id="StartupShortcuts" />
    </Feature>

    <!-- 
      Directory Structure
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WhisperKey\WhisperKey">
        <Directory Id="ResourcesFolder" Name="Resources" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WhisperKeyProgramMenuFolder" Name="WhisperKey" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="StartupFolder" />

    <!-- 
      Properties
    -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
    <Property Id="AUTOSTART" Value="0" />
    <Property Id="INSTALLQUICKLAUNCH" Value="0" />
    
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://whisperkey.app" />
    <Property Id="ARPHELPLINK" Value="https://whisperkey.app/support" />

    <!-- 
      Icon
    -->
    <Icon Id="ProductIcon.exe" SourceFile="..\Resources\WhisperKey.ico" />

  </Package>

  <!-- 
    System Checks
    Launch conditions must be outside Package in WiX v4
  -->
  <Fragment>
    <Launch Condition="Installed OR (VersionNT >= 603)" 
            Message="This application requires Windows 10 or later." />
    <Launch Condition="Installed OR VersionNT64" 
            Message="This application requires 64-bit Windows." />
    <Launch Condition="Installed OR Privileged" 
            Message="You must be an administrator to install this application." />
  </Fragment>

</Wix>
